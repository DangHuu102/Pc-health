<Window x:Class="PCHealthDashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:vm="clr-namespace:PCHealthDashboard.ViewModels"
        Title="PC Health Dashboard" Height="820" Width="1300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        MouseDown="Window_MouseDown">
    
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Border CornerRadius="12" Background="#0f111a" BorderBrush="#1C2230" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <!-- Main Content Area -->
            <Grid Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🖥 PC Health" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,15,0"/>
                        <TextBlock Text="Dashboard" Foreground="#AAA" FontSize="20" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Customize" Foreground="#ccc" Background="#1a202c" BorderThickness="0" Padding="12,6" Margin="0,0,10,0" Cursor="Hand"/>
                        <Button Content="─" Foreground="#ccc" Background="Transparent" BorderThickness="0" FontSize="14" Click="MinimizeButton_Click" Cursor="Hand" Padding="10,0" ToolTip="Thu nhỏ"/>
                        <Button Content="✕" Foreground="#ccc" Background="Transparent" BorderThickness="0" FontSize="16" Click="CloseButton_Click" Cursor="Hand" Padding="10,0" ToolTip="Đóng"/>
                    </StackPanel>
                </Grid>

                <!-- Top Cards -->
                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentView}" Value="Tổng quan">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Health Score Card -->
                    <Border Grid.Column="0" Background="#151b26" CornerRadius="12" Padding="18,15" Margin="0,0,10,0" BorderBrush="#1C2230" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0: Gauge + Score + Cat -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="55"/>
                                </Grid.ColumnDefinitions>

                                <!-- Circular Gauge -->
                                <Grid Grid.Column="0" Width="65" Height="65">
                                    <lvc:PieChart Series="{Binding HealthSeries}" InitialRotation="-90" Background="Transparent" LegendPosition="Hidden" TooltipPosition="Hidden" Margin="-4"/>
                                    <TextBlock Text="{Binding HealthScore}" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Score Text -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Text="Health Score" Foreground="#94a3b8" FontSize="12" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding HealthScore}" Foreground="#4ade80" FontSize="22" FontWeight="Bold"/>
                                        <TextBlock Text=" / 100" Foreground="#475569" FontSize="16" VerticalAlignment="Bottom" Margin="3,0,0,2"/>
                                    </StackPanel>
                                    <Border Background="#0d2818" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="#4ade80" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Excellent" Foreground="#4ade80" FontSize="10" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Bongo Cat Vector -->
                                <Viewbox Grid.Column="2" Width="50" Height="50" VerticalAlignment="Center">
                                    <Canvas Width="100" Height="80">
                                        <Path Data="M 20 70 L 30 35 Q 35 30 45 33 Q 60 25 75 33 Q 85 30 90 35 L 100 70" Stroke="#a855f7" StrokeThickness="3" Fill="Transparent"/>
                                        <Path Data="M 30 70 C 30 55 50 55 50 70" Stroke="#a855f7" StrokeThickness="3" Fill="#151b26"/>
                                        <Path Data="M 70 70 C 70 55 90 55 90 70" Stroke="#a855f7" StrokeThickness="3" Fill="#151b26"/>
                                        <Ellipse Canvas.Left="42" Canvas.Top="48" Width="5" Height="5" Fill="#a855f7"/>
                                        <Ellipse Canvas.Left="73" Canvas.Top="48" Width="5" Height="5" Fill="#a855f7"/>
                                        <Path Data="M 55 55 Q 60 59 65 55" Stroke="#a855f7" StrokeThickness="2" Fill="Transparent"/>
                                        <Line X1="90" Y1="18" X2="86" Y2="26" Stroke="#4ade80" StrokeThickness="2.5" StrokeEndLineCap="Round"/>
                                        <Line X1="100" Y1="14" X2="96" Y2="24" Stroke="#4ade80" StrokeThickness="2.5" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Grid>

                            <!-- Row 1: Subtitle -->
                            <TextBlock Grid.Row="1" Foreground="#64748b" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap">Máy tính hoạt động tốt. Hãy duy trì nhé!</TextBlock>
                        </Grid>
                    </Border>
                    
                    <!-- CPU Card -->
                    <Border Grid.Column="1" Background="#151b26" CornerRadius="10" Padding="15" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="CPU" Foreground="#AAA" FontSize="13" Margin="0,0,0,5"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding CpuTemp, StringFormat={}{0:F0}°C}" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding CpuUsage, StringFormat={}{0:F0}%}" Foreground="#888" FontSize="13" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                            </StackPanel>
                            <ProgressBar Value="{Binding CpuUsage}" Maximum="100" Width="80" HorizontalAlignment="Left" Height="4" Foreground="#3b82f6" Background="#1C2230" BorderThickness="0" Margin="0,15,0,0"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- GPU Card -->
                    <Border Grid.Column="2" Background="#151b26" CornerRadius="10" Padding="15" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="GPU" Foreground="#AAA" FontSize="13" Margin="0,0,0,5"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding GpuTemp, StringFormat={}{0:F0}°C}" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding GpuUsage, StringFormat={}{0:F0}%}" Foreground="#888" FontSize="13" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                            </StackPanel>
                            <ProgressBar Value="{Binding GpuUsage}" Maximum="100" Width="80" HorizontalAlignment="Left" Height="4" Foreground="#a855f7" Background="#1C2230" BorderThickness="0" Margin="0,15,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- RAM Card -->
                    <Border Grid.Column="3" Background="#151b26" CornerRadius="10" Padding="15" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="RAM" Foreground="#AAA" FontSize="13" Margin="0,0,0,5"/>
                            <TextBlock Foreground="White" FontSize="18" FontWeight="Bold">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0:F1} / {1:F0} GB">
                                        <Binding Path="RamUsed"/>
                                        <Binding Path="RamTotal"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <ProgressBar Value="{Binding RamUsed}" Maximum="{Binding RamTotal}" Width="80" HorizontalAlignment="Left" Height="4" Foreground="#4ade80" Background="#1C2230" BorderThickness="0" Margin="0,15,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Storage Card -->
                    <Border Grid.Column="4" Background="#151b26" CornerRadius="10" Padding="15" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Storage" Foreground="#AAA" FontSize="13" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding SsdFreeSpace, StringFormat={}{0:F0} GB}" Foreground="White" FontSize="18" FontWeight="Bold"/>
                            <ProgressBar Value="{Binding SsdUsedSpace}" Maximum="{Binding SsdTotalSpace}" Width="80" HorizontalAlignment="Left" Height="4" Foreground="#f59e0b" Background="#1C2230" BorderThickness="0" Margin="0,15,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Network Card -->
                    <Border Grid.Column="5" Background="#151b26" CornerRadius="10" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Network" Foreground="#AAA" FontSize="13" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding PingLatency, StringFormat={}{0} ms}" Foreground="White" FontSize="18" FontWeight="Bold"/>
                            <ProgressBar Value="{Binding PingLatency}" Maximum="200" Width="80" HorizontalAlignment="Left" Height="4" Foreground="#06b6d4" Background="#1C2230" BorderThickness="0" Margin="0,15,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Mid Section: Charts & Alerts -->
                <Grid Grid.Row="2" Margin="0,0,0,20">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentView}" Value="Tổng quan">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.8*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- 6 Charts Grid -->
                    <Grid Grid.Column="0" Margin="0,0,15,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="HIỂN THỊ BIỂU ĐỒ LỊCH SỬ" Foreground="#AAA" FontSize="14" Margin="0,0,0,10"/>

                        <!-- Chart 1: CPU -->
                        <Border Grid.Row="1" Grid.Column="0" Background="#151b26" CornerRadius="8" Padding="10" Margin="0,0,10,10">
                            <Grid>
                                <TextBlock Text="CPU Usage (%)" Foreground="#3b82f6" FontSize="12" VerticalAlignment="Top"/>
                                <TextBlock Text="{Binding CpuUsage, StringFormat={}{0:F0}%}" Foreground="#3b82f6" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                <lvc:CartesianChart Background="Transparent" Series="{Binding CpuSeries}" XAxes="{Binding ChartXAxes}" YAxes="{Binding ChartYAxes}" Margin="0,15,0,0" TooltipPosition="Hidden"/>
                            </Grid>
                        </Border>

                        <!-- Chart 2: GPU -->
                        <Border Grid.Row="1" Grid.Column="1" Background="#151b26" CornerRadius="8" Padding="10" Margin="0,0,10,10">
                            <Grid>
                                <TextBlock Text="GPU Usage (%)" Foreground="#a855f7" FontSize="12" VerticalAlignment="Top"/>
                                <TextBlock Text="{Binding GpuUsage, StringFormat={}{0:F0}%}" Foreground="#a855f7" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                <lvc:CartesianChart Background="Transparent" Series="{Binding GpuSeries}" XAxes="{Binding ChartXAxes}" YAxes="{Binding ChartYAxes}" Margin="0,15,0,0" TooltipPosition="Hidden"/>
                            </Grid>
                        </Border>

                        <!-- Chart 3: RAM -->
                        <Border Grid.Row="1" Grid.Column="2" Background="#151b26" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                            <Grid>
                                <TextBlock Text="RAM Usage (%)" Foreground="#4ade80" FontSize="12" VerticalAlignment="Top"/>
                                <lvc:CartesianChart Background="Transparent" Series="{Binding RamSeries}" XAxes="{Binding ChartXAxes}" YAxes="{Binding ChartYAxes}" Margin="0,15,0,0" TooltipPosition="Hidden"/>
                            </Grid>
                        </Border>

                        <!-- Chart 4: Storage -->
                        <Border Grid.Row="2" Grid.Column="0" Background="#151b26" CornerRadius="8" Padding="10" Margin="0,0,10,0">
                            <Grid>
                                <TextBlock Text="Storage Usage (%)" Foreground="#f59e0b" FontSize="12" VerticalAlignment="Top"/>
                                <lvc:CartesianChart Background="Transparent" Series="{Binding StorageSeries}" XAxes="{Binding ChartXAxes}" YAxes="{Binding ChartYAxes}" Margin="0,15,0,0" TooltipPosition="Hidden"/>
                            </Grid>
                        </Border>

                        <!-- Chart 5: Ping -->
                        <Border Grid.Row="2" Grid.Column="1" Background="#151b26" CornerRadius="8" Padding="10" Margin="0,0,10,0">
                            <Grid>
                                <TextBlock Text="Network Ping (ms)" Foreground="#06b6d4" FontSize="12" VerticalAlignment="Top"/>
                                <TextBlock Text="{Binding PingLatency, StringFormat={}{0} ms}" Foreground="#06b6d4" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                <lvc:CartesianChart Background="Transparent" Series="{Binding PingSeries}" XAxes="{Binding ChartXAxes}" YAxes="{Binding ChartYAxes}" Margin="0,15,0,0" TooltipPosition="Hidden"/>
                            </Grid>
                        </Border>

                        <!-- Chart 6: Packet Loss -->
                        <Border Grid.Row="2" Grid.Column="2" Background="#151b26" CornerRadius="8" Padding="10" Margin="0,0,0,0">
                            <Grid>
                                <TextBlock Text="Network Loss (%)" Foreground="#0ea5e9" FontSize="12" VerticalAlignment="Top"/>
                                <TextBlock Text="{Binding PacketLoss, StringFormat={}{0:F1}%}" Foreground="#0ea5e9" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                <lvc:CartesianChart Background="Transparent" Series="{Binding LossSeries}" XAxes="{Binding ChartXAxes}" YAxes="{Binding ChartYAxes}" Margin="0,15,0,0" TooltipPosition="Hidden"/>
                            </Grid>
                        </Border>
                    </Grid>
                    
                    <!-- Right Side: Alerts & Info -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.2*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="CẢNH BÁO HỆ THỐNG" Foreground="#ef4444" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding SystemAlerts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                            <Border.Background>
                                                <SolidColorBrush Color="#222" Opacity="0.5"/>
                                            </Border.Background>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" Foreground="{Binding Color}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,3"/>
                                                <TextBlock Text="{Binding Message}" Foreground="#AAA" FontSize="12" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- System Info Bottom Right (Mock styling from image) -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                            <TextBlock Text="THÔNG TIN HỆ THỐNG" Foreground="#06b6d4" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Tên máy" Foreground="#888" FontSize="12"/>
                                <TextBlock Text="DESKTOP-PC" Foreground="White" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Hệ điều hành" Foreground="#888" FontSize="12"/>
                                <TextBlock Text="Windows 11" Foreground="White" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Bottom Status -->
                <Grid Grid.Row="3">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentView}" Value="Tổng quan">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel>
                        <TextBlock Text="Ổ ĐĨA (SSD &amp; HDD)" Foreground="#06b6d4" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding Drives}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#151b26" CornerRadius="8" Padding="15,10" Margin="0,0,0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="2.5*"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border BorderBrush="#4ade80" BorderThickness="1" CornerRadius="3" Padding="5,2" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Type}" Foreground="#4ade80" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock Foreground="White" FontSize="13" FontWeight="SemiBold">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0} ({1})">
                                                                <Binding Path="Name" Mode="OneWay"/>
                                                                <Binding Path="Type" Mode="OneWay"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                    <TextBlock Foreground="#888" FontSize="11">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0:F0} GB • {1}">
                                                                <Binding Path="TotalGB"/>
                                                                <Binding Path="Interface"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                            
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                                <TextBlock Text="Health" Foreground="#AAA" FontSize="11" Margin="0,0,0,2"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding HealthString, Mode=OneWay}" Foreground="White" FontSize="14" FontWeight="Bold" Width="40"/>
                                                    <ProgressBar Value="{Binding Health, Mode=OneWay}" Maximum="100" Width="60" Height="4" Foreground="#4ade80" Background="#0f111a" BorderThickness="0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0">
                                                <TextBlock Text="Used" Foreground="#AAA" FontSize="11" Margin="0,0,0,2"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding UsedPercent, StringFormat={}{0:F0}%, Mode=OneWay}" Foreground="White" FontSize="14" FontWeight="Bold" Width="40"/>
                                                    <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Width="60" Height="4" Foreground="#f59e0b" Background="#0f111a" BorderThickness="0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="10,0">
                                                <TextBlock Text="Free" Foreground="#AAA" FontSize="11" Margin="0,0,0,2"/>
                                                <TextBlock Foreground="White" FontSize="13" FontWeight="SemiBold">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0:F0} GB / {1:F0} GB">
                                                            <Binding Path="FreeGB"/>
                                                            <Binding Path="TotalGB"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Text="Nhiệt độ" Foreground="#AAA" FontSize="11" Margin="0,0,0,2" HorizontalAlignment="Right"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Ellipse Width="8" Height="8" Fill="#4ade80" Margin="0,0,5,0"/>
                                                    <TextBlock Text="{Binding TempString}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <!-- Coming Soon View -->
                <Grid Grid.Row="1" Grid.RowSpan="3">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentView}" Value="Tổng quan">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🛠" FontSize="60" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <TextBlock Text="{Binding CurrentView}" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Chức năng đang được phát triển..." Foreground="#AAA" FontSize="16" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>
