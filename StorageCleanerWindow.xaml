<Window x:Class="PCHealthDashboard.StorageCleanerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PCHealthDashboard.ViewModels"
        Title="Storage Cleaner" Height="600" Width="800"
        WindowStyle="None" AllowsTransparency="False" Background="#0f111a"
        WindowStartupLocation="CenterOwner"
        MouseDown="Window_MouseDown">
    
    <Window.DataContext>
        <vm:StorageCleanerViewModel/>
    </Window.DataContext>

    <Border CornerRadius="12" Background="#0f111a" BorderBrush="#1C2230" BorderThickness="1" ClipToBounds="True">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🧹 Storage Cleaner" Foreground="White" FontSize="18" FontWeight="Bold"/>
                </StackPanel>
                <Button Content="✕" HorizontalAlignment="Right" Foreground="#ccc" Background="Transparent" BorderThickness="0" FontSize="16" Click="CloseButton_Click" Cursor="Hand" Padding="10,0"/>
            </Grid>

            <!-- Controls -->
            <Grid Grid.Row="1" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Chọn ổ đĩa:" Foreground="#AAA" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox ItemsSource="{Binding AvailableDrives}" SelectedItem="{Binding SelectedDrive}" Width="80" Height="28" VerticalContentAlignment="Center" Background="#151b26" Foreground="Black"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Quét rác hệ thống" Command="{Binding ScanJunkCommand}" Width="130" Height="30" Background="#3b82f6" Foreground="White" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" FontWeight="SemiBold"/>
                    <Button Content="Quét file trùng lặp" Command="{Binding ScanDuplicatesCommand}" Width="130" Height="30" Background="#f59e0b" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>

            <!-- List Area -->
            <Border Grid.Row="2" Background="#151b26" CornerRadius="8" BorderBrush="#1e293b" BorderThickness="1" Margin="0,0,0,15">
                <Grid>
                    <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" HeadersVisibility="Column" Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="#1a202c" Foreground="#e2e8f0" BorderThickness="0" GridLinesVisibility="None" IsReadOnly="False" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="40">
                                <DataGridCheckBoxColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="Chọn" Foreground="#AAA"/>
                                    </DataTemplate>
                                </DataGridCheckBoxColumn.HeaderTemplate>
                            </DataGridCheckBoxColumn>
                            <DataGridTextColumn Header="Đường dẫn" Binding="{Binding Path}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Phân loại" Binding="{Binding Category}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Kích thước" Binding="{Binding SizeString}" Width="100" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Bottom Bar -->
            <Grid Grid.Row="3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#AAA" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Dung lượng chọn xóa:" Foreground="#AAA" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding TotalSizeString}" Foreground="#ef4444" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Button Content="Xóa mục đã chọn" Command="{Binding RemoveSelectedCommand}" Width="130" Height="32" Background="#ef4444" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
